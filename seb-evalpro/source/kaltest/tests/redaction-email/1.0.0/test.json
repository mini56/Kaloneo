{
  "kaltestFormat": 1,
  "minSebEvalPro": "0.1.0-dev",
  "builderVersion": "2.0.0",
  "id": "redaction_email",
  "version": "1.0.0",
  "title": "Rédaction d’un e-mail",
  "category": "tic",
  "description": "Rédiger et adresser un e-mail professionnel avec objet, pièce jointe, signature et téléphone.",
  "kind": "questionnaire",
  "scored": true,
  "sourceMigration": {
    "baseline": "SEB EvalPro 0.3.10 Build #20",
    "sourcePage": "nvmail.html",
    "sourceScript": "source/js/nvmail-page.js",
    "legacyParcoursId": "nvmail"
  },
  "calculator": {
    "compatible": false,
    "defaultEnabled": false
  },
  "scenario": "Votre conseiller vous contacte par e-mail pour vous prévenir que votre rendez-vous est déplacé. Il vous demande de lui envoyer votre rapport de stage en entreprise.",
  "instruction": "Vous devez répondre à son e-mail. Envoyez votre message sur les adresses e-mail indiquées dans les consignes, rédigez le message demandé et choisissez la pièce jointe appropriée.",
  "presentation": {
    "layout": "50-50",
    "mailComposer": {
      "instructions": [
        "Vous devez répondre à son e-mail. Envoyez votre message sur les adresses e-mail suivantes :",
        "À votre conseiller : conseil.perso@kaloneo.org",
        "En copie à votre responsable de stage : stage-pro@kaloneo.org",
        "Dans l'éditeur, mettez en forme votre texte en respectant les consignes ci-dessous.",
        "Mettez en objet : Prénom* Mail-Kalonéo",
        "Ajoutez votre rapport en pièce jointe.",
        "Saisissez un message avec une formule de politesse en introduction et à la fin puis une signature avec votre prénom, nom et numéro de téléphone sur le modèle ci-dessous :",
        "Prénom NOM",
        "01.02.34.56.78**",
        "* Mettre votre prénom.",
        "** utilisez un numéro de téléphone fictif."
      ],
      "fields": {
        "to": "mail_to",
        "cc": "mail_cc",
        "subject": "mail_subject",
        "signature": "mail_signature",
        "phone": "mail_phone",
        "file": "mail_file"
      },
      "files": [
        "CV_Julie.pdf",
        "Rapport_stage.docx",
        "Facture_2023.xlsx",
        "Memo.txt"
      ],
      "illustration": "imageqcm/Espace de travail dédié aux e-mails.png",
      "subjectSuffix": "Mail-Kalonéo",
      "theme": "light-green"
    }
  },
  "evaluation": {
    "mailRules": true
  },
  "behavior": {
    "validateBeforeAdvance": true,
    "validationLabel": "Envoyer",
    "validationSuccessMessage": "Message envoyé !"
  },
  "runtime": {
    "start": true,
    "save": true,
    "restore": true,
    "finish": true
  },
